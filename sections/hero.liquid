<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__glow2" aria-hidden="true"></div>

  <p class="ew ew--c hero__eyebrow">{{ section.settings.eyebrow | default: 'Recette ancestrale du Caucase' }}</p>

  <h1 class="hero__title">
    {{ section.settings.title_line1 | default: 'Pas de baguette magique,' }}<br>
    <em class="g">{{ section.settings.title_line2 | default: 'juste la nature.' }}</em>
  </h1>

  <p class="hero__lead">{{ section.settings.subtitle | default: 'Le savon noir capillaire thérapeutique — 14 ingrédients naturels, des résultats visibles dès la 2ᵉ semaine.' }}</p>

  <div class="hero__img-frame">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Kavkaz Gold Black" class="hero__img" width="800" height="600" loading="eager">
    {%- else -%}
      <div class="placeholder" style="height:320px"><span>Photo produit</span></div>
    {%- endif -%}
  </div>

  <a href="{{ section.settings.cta_url | default: '/collections/nos-produits' }}" class="btn btn-gold btn-full btn-lg">
    {{ section.settings.cta_label | default: 'Découvrir le soin' }}
  </a>

  <div class="hero__pills">
    <span class="hero__pill">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Sans sulfates
    </span>
    <span class="hero__pill">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Sans parabènes
    </span>
    <span class="hero__pill">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Sans silicones
    </span>
  </div>
</section>

{% schema %}
{
  "name": "Héro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Recette ancestrale du Caucase" },
    { "type": "text", "id": "title_line1", "label": "Titre ligne 1", "default": "Pas de baguette magique," },
    { "type": "text", "id": "title_line2", "label": "Titre or italique (ligne 2)", "default": "juste la nature." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Une recette ancestrale du Caucase — 14 actifs naturels qui nettoient, désinfectent et purifient le cuir chevelu. Et sur un cuir chevelu sain, tout suit : chute freinée, repousse, zéro pellicule, brillance, douceur. Dès la 2ᵉ semaine." },
    { "type": "image_picker", "id": "image", "label": "Photo produit" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir le soin" },
    { "type": "url", "id": "cta_url", "label": "Lien bouton" }
  ],
  "presets": [{ "name": "Héro" }]
}
{% endschema %}
