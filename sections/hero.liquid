<section class="hero">
  <div class="hero__orb"></div>

  <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | default: 'Recette ancestrale du Caucase' }}</p>

  <h1 class="hero__title">
    {{ section.settings.title_line1 | default: 'Stoppe la chute,' }}<br>
    relance la <em class="gold-text">{{ section.settings.title_line2 | default: 'repousse' }}</em>.
  </h1>

  <p class="hero__sub">{{ section.settings.subtitle | default: 'Le savon noir capillaire thérapeutique — 14 ingrédients naturels, des résultats visibles dès la 2ᵉ semaine.' }}</p>

  <div class="hero__img-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Kavkaz Gold Black" width="800" height="600" loading="eager" class="hero__img">
    {%- else -%}
      <img src="{{ 'product-solo.jpg' | asset_url }}" alt="Kavkaz Gold Black" width="800" height="600" loading="eager" class="hero__img">
    {%- endif -%}
  </div>

  <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-gold btn-full btn-lg">
    {{ section.settings.cta_label | default: 'Découvrir le soin' }}
  </a>

  <div class="hero__free-from">
    <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> Sans sulfates</span>
    <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> Sans parabènes</span>
    <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> Sans silicones</span>
  </div>
</section>

{% schema %}
{
  "name": "Héro",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Recette ancestrale du Caucase" },
    { "type": "text", "id": "title_line1", "label": "Titre ligne 1", "default": "Stoppe la chute," },
    { "type": "text", "id": "title_line2", "label": "Titre or italique", "default": "repousse" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Le savon noir capillaire thérapeutique — 14 ingrédients naturels, des résultats visibles dès la 2ᵉ semaine." },
    { "type": "image_picker", "id": "image", "label": "Photo produit" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir le soin" },
    { "type": "url", "id": "cta_url", "label": "Lien bouton" }
  ],
  "presets": [{ "name": "Héro" }]
}
{% endschema %}
