<footer class="site-footer">
  <div class="container">
    <div class="ft-logo">KAVKAZ</div>
    <div class="ft-sub">GOLD · BLACK</div>
    <nav class="ft-nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- else -%}
        <a href="/pages/notre-histoire-1">Notre histoire</a>
        <a href="/pages/faq-questions-frequentes">FAQ</a>
        <a href="/policies/shipping-policy">Livraison</a>
        <a href="/pages/mentions-legales-cgv">Mentions légales</a>
      {%- endfor -%}
    </nav>
    <p class="ft-copy">© {{ 'now' | date: '%Y' }} Kavkaz Gold Black · Fabriqué à partir d'ingrédients du Caucase</p>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
