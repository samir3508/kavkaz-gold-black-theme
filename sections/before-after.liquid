<section class="section ba">
  <div class="container">
    <p class="ew ew--c">{{ section.settings.eyebrow | default: 'Résultats réels' }}</p>
    <h2 class="sh tc">{{ section.settings.title | default: 'La cure de 3 mois' }}</h2>

    <div class="ba__grid">
      <div>
        {%- if section.settings.before != blank -%}
          <img src="{{ section.settings.before | image_url: width: 600 }}" alt="Avant" class="ba__img" loading="lazy">
        {%- else -%}
          <div class="placeholder ba__img"><span>Photo avant</span></div>
        {%- endif -%}
        <p class="ba__tag ba__tag--muted">SEMAINE 0</p>
      </div>
      <div>
        {%- if section.settings.after != blank -%}
          <img src="{{ section.settings.after | image_url: width: 600 }}" alt="Après" class="ba__img" loading="lazy">
        {%- else -%}
          <div class="placeholder ba__img"><span>Photo après</span></div>
        {%- endif -%}
        <p class="ba__tag ba__tag--gold">SEMAINE 12</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avant / Après",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Résultats réels" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La cure de 3 mois" },
    { "type": "image_picker", "id": "before", "label": "Photo avant" },
    { "type": "image_picker", "id": "after", "label": "Photo après" }
  ],
  "presets": [{ "name": "Avant / Après" }]
}
{% endschema %}
