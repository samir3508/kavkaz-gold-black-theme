<section class="before-after section-pad" style="background:var(--ink)">
  <div class="container">
    <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | default: 'Résultats réels' }}</p>
    <h2 class="section-title text-center">{{ section.settings.title | default: 'La cure de 3 mois' }}</h2>
    <div class="before-after__grid">
      <div class="before-after__item">
        {%- if section.settings.before != blank -%}
          <img src="{{ section.settings.before | image_url: width: 600 }}" alt="Avant" class="before-after__img" loading="lazy">
        {%- else -%}
          <div class="img-placeholder"><span>Photo avant</span></div>
        {%- endif -%}
        <p class="before-after__tag before-after__tag--muted">SEMAINE 0</p>
      </div>
      <div class="before-after__item">
        {%- if section.settings.after != blank -%}
          <img src="{{ section.settings.after | image_url: width: 600 }}" alt="Après" class="before-after__img" loading="lazy">
        {%- else -%}
          <div class="img-placeholder"><span>Photo après</span></div>
        {%- endif -%}
        <p class="before-after__tag before-after__tag--gold">SEMAINE 12</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avant / Après",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Résultats réels" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La cure de 3 mois" },
    { "type": "image_picker", "id": "before", "label": "Photo avant" },
    { "type": "image_picker", "id": "after", "label": "Photo après" }
  ],
  "presets": [{ "name": "Avant / Après" }]
}
{% endschema %}
