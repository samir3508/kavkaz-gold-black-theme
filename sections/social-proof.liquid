<section class="section proof">
  <div class="container">

    <a href="https://www.instagram.com/{{ section.settings.ig_handle | default: 'kavkazgoldblack' }}/" target="_blank" rel="noopener" class="ig-cta">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="flex-shrink:0"><rect x="3" y="3" width="18" height="18" rx="5" stroke="#C9A84C" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="#C9A84C" stroke-width="1.5"/><circle cx="17.2" cy="6.8" r="1.1" fill="#C9A84C"/></svg>
      <span>Voir les témoignages clients sur notre Instagram <strong>@{{ section.settings.ig_handle | default: 'kavkazgoldblack' }}</strong></span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex-shrink:0"><path d="M7 17L17 7M17 7H7M17 7v10" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>

    <p class="ew" style="margin-bottom:16px">{{ section.settings.title | default: 'Avis vérifiés' }}</p>

    {%- if section.settings.tp_business_id != blank -%}
      {%- case section.settings.tp_template -%}
        {%- when 'micro' -%}
          {%- assign tp_template_id = '5419b6ffb0d04a076446a9af' -%}
          {%- assign tp_height = '24px' -%}
        {%- when 'carousel' -%}
          {%- assign tp_template_id = '53aa8912dec7e10d38f59f36' -%}
          {%- assign tp_height = '140px' -%}
        {%- else -%}
          {%- assign tp_template_id = '56278e9abfbbba0bdcd568bc' -%}
          {%- assign tp_height = '52px' -%}
      {%- endcase -%}
      <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
      <div class="trustpilot-widget" style="margin:0 0 28px"
        data-locale="fr-FR"
        data-template-id="{{ tp_template_id }}"
        data-businessunit-id="{{ section.settings.tp_business_id }}"
        data-style-height="{{ tp_height }}"
        data-style-width="100%"
        data-theme="dark">
        <a href="https://fr.trustpilot.com/review/kavkaz.fr" target="_blank" rel="noopener">Trustpilot</a>
      </div>
    {%- endif -%}

    <div class="reviews">
      {%- for block in section.blocks -%}
        <div class="review" {{ block.shopify_attributes }}>
          <div class="review__stars">
            {%- assign r = block.settings.rating | default: 5 -%}
            {%- for i in (1..5) -%}
              <svg width="13" height="13" viewBox="0 0 20 20"><path d="M10 1.5l2.47 5.26 5.78.72-4.27 3.95 1.12 5.72L10 14.4l-5.1 2.75 1.12-5.72L1.75 7.48l5.78-.72z" fill="{% if i <= r %}#C9A84C{% else %}rgba(201,168,76,0.22){% endif %}"/></svg>
            {%- endfor -%}
          </div>
          <p class="review__text">"{{ block.settings.text }}"</p>
          <div class="review__author">
            <span class="review__name">{{ block.settings.name }}</span>
            <span class="review__loc"> · {{ block.settings.location }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Preuve sociale",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "ig_handle", "label": "Handle Instagram (sans @)", "default": "kavkazgoldblack" },
    { "type": "text", "id": "title", "label": "Titre avis", "default": "Avis vérifiés" },
    { "type": "header", "content": "Trustpilot" },
    { "type": "text", "id": "tp_business_id", "label": "Business Unit ID Trustpilot", "info": "Dans le code du widget Trustpilot : data-businessunit-id. Laisser vide pour masquer le widget." },
    {
      "type": "select",
      "id": "tp_template",
      "label": "Type de widget Trustpilot",
      "options": [
        { "value": "collector", "label": "Collecteur d'avis (recommandé au départ)" },
        { "value": "micro", "label": "Micro combo (note + nombre d'avis)" },
        { "value": "carousel", "label": "Carrousel d'avis" }
      ],
      "default": "collector"
    }
  ],
  "blocks": [{
    "type": "review",
    "name": "Avis",
    "settings": [
      { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Texte" },
      { "type": "text", "id": "name", "label": "Nom" },
      { "type": "text", "id": "location", "label": "Ville" }
    ]
  }],
  "presets": [{
    "name": "Preuve sociale",
    "blocks": [
      { "type": "review", "settings": { "rating": 5, "text": "En 3 semaines mes pellicules ont disparu et je vois déjà des petits cheveux repousser sur les tempes. Bluffée.", "name": "Inès K.", "location": "Lyon" } },
      { "type": "review", "settings": { "rating": 5, "text": "Ma chute s'est nettement calmée au bout d'un mois. L'odeur est naturelle, rien à voir avec les shampoings classiques.", "name": "Karim B.", "location": "Paris" } },
      { "type": "review", "settings": { "rating": 5, "text": "Cheveux plus épais et un cuir chevelu enfin apaisé. Je suis sur le pack 3 mois, je recommande.", "name": "Sofia R.", "location": "Marseille" } }
    ]
  }]
}
{% endschema %}
