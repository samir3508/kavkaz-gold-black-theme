<div class="coll-page">
  <h1>{{ collection.title }}</h1>
  <div class="coll-grid">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="pcard">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="pcard__img" width="600" height="600" loading="lazy">
        {%- else -%}
          <div class="placeholder pcard__img"><span>{{ product.title }}</span></div>
        {%- endif -%}
        <div class="pcard__info">
          <div class="pcard__name">{{ product.title }}</div>
          <div class="pcard__price g">{{ product.price | money }}</div>
        </div>
      </a>
    {%- else -%}
      <p style="color:var(--muted)">Aucun produit dans cette collection.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Page Collection", "tag": "section", "settings": [], "presets": [{ "name": "Page Collection" }] }
{% endschema %}
