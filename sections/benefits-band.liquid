<section class="ben-band">
  <div class="ben-band__grid">
    {%- for block in section.blocks -%}
      <div class="ben-band__item" {{ block.shopify_attributes }}>
        <span class="ben-band__num g">{{ block.settings.number }}</span>
        <span class="ben-band__lbl">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bande bénéfices",
  "tag": "section",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Chiffre", "default": "−100%" },
        { "type": "text", "id": "label", "label": "Description", "default": "Chute stoppée dès 1 mois" }
      ]
    }
  ],
  "presets": [{
    "name": "Bande bénéfices",
    "blocks": [
      { "type": "stat", "settings": { "number": "−100%", "label": "Chute stoppée dès 1 mois" } },
      { "type": "stat", "settings": { "number": "1 mois", "label": "Première repousse visible" } },
      { "type": "stat", "settings": { "number": "2 sem.", "label": "Cuir chevelu assaini" } }
    ]
  }]
}
{% endschema %}
