<div class="pg-page container">
  <a href="{{ blog.url }}" class="article-back">← {{ blog.title }}</a>
  <span class="fl">
    {{ article.published_at | date: "%d %B %Y" }}{% if article.author %} · {{ article.author }}{% endif %}
  </span>
  <h1>{{ article.title }}</h1>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" class="article-hero" width="1200" height="675" loading="lazy">
  {%- endif -%}
  <div class="rte article-body">{{ article.content }}</div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncatewords: 40 | json }},
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  {%- if article.updated_at %}
  "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  {%- endif %}
  {%- if article.image %}
  "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }},
  {%- endif %}
  "author": { "@type": "Organization", "name": {{ article.author | default: shop.name | json }} },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": { "@type": "ImageObject", "url": {{ 'logo.png' | asset_url | prepend: "https:" | json }} }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} }
}
</script>

{% schema %}
{ "name": "Page Article", "tag": "section", "settings": [], "presets": [{ "name": "Page Article" }] }
{% endschema %}
