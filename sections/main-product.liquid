        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink:0"><path d="M12 2l2.47 5.26 5.78.72-4.27 3.95 1.12 5.72L12 14.9l-5.1 2.75 1.12-5.72L3.75 7.98l5.78-.72z" fill="#00B67A"/></svg>
