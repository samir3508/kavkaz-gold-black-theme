<div class="product-page">
  <!-- Galerie -->
  <div class="product-gallery">
    <div class="product-gallery__main">
      {%- if product.featured_image -%}
        <img id="pf-img" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="800" loading="eager" class="product-gallery__main-img">
      {%- else -%}
        <div class="img-placeholder tall"><span>Photo produit</span></div>
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="product-gallery__thumbs">
        {%- for img in product.images -%}
          <button class="thumb {% if forloop.first %}thumb--active{% endif %}" data-src="{{ img | image_url: width: 800 }}" onclick="document.getElementById('pf-img').src=this.dataset.src;document.querySelectorAll('.thumb').forEach(t=>t.classList.remove('thumb--active'));this.classList.add('thumb--active')">
            <img src="{{ img | image_url: width: 120 }}" alt="{{ img.alt | escape }}" width="120" height="120" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Infos -->
  <div class="product-info container">
    <p class="eyebrow">Savon noir capillaire</p>
    <h1 class="product-info__title">{{ product.title }}</h1>
    <div class="product-info__rating">
      {%- for i in (1..5) -%}<svg width="15" height="15" viewBox="0 0 20 20"><path d="M10 1.5l2.47 5.26 5.78.72-4.27 3.95 1.12 5.72L10 14.4l-5.1 2.75 1.12-5.72L1.75 7.48l5.78-.72z" fill="#C9A84C"/></svg>{%- endfor -%}
      <span class="product-info__rating-label">4,9 · 124 avis</span>
    </div>

    <div class="product-info__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="price-was">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
      <span class="price-now gold-text" id="pf-price">{{ product.price | money }}</span>
    </div>

    <p class="product-info__blurb">{{ product.description | strip_html | truncate: 120 }}</p>

    {%- form 'product', product, id: 'product-form' -%}
      <input type="hidden" name="id" id="pf-variant" value="{{ product.selected_or_first_available_variant.id }}">

      <!-- Sélecteur format -->
      {%- if product.variants.size > 1 -%}
        <p class="field-label">CHOISIR LE FORMAT</p>
        <div class="variant-list">
          {%- for v in product.variants -%}
            <label class="variant-card {% if forloop.first %}variant-card--active{% endif %}">
              <input type="radio" name="variant_radio" value="{{ v.id }}" {% if forloop.first %}checked{% endif %}
                onchange="document.getElementById('pf-variant').value=this.value;document.getElementById('pf-price').textContent='{{ v.price | money }}';document.querySelectorAll('.variant-card').forEach(c=>c.classList.remove('variant-card--active'));this.closest('.variant-card').classList.add('variant-card--active')">
              <div class="variant-card__info">
                <span class="variant-card__name">{{ v.title }}</span>
                <span class="variant-card__sub">{% if v.title contains '3' or v.title contains 'Pack' %}Cure complète · 3 mois{% else %}1 mois de soin{% endif %}</span>
              </div>
              <div class="variant-card__right">
                <span class="variant-card__price">{{ v.price | money }}</span>
                {%- if v.compare_at_price > v.price -%}
                  <span class="variant-card__badge">Le plus choisi</span>
                {%- endif -%}
                <span class="variant-card__radio"></span>
              </div>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Quantité -->
      <div class="qty-row">
        <span class="field-label">QUANTITÉ</span>
        <div class="qty-ctrl">
          <button type="button" class="qty-btn" onclick="var i=document.getElementById('pf-qty');i.value=Math.max(1,+i.value-1)">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
          <input type="number" id="pf-qty" name="quantity" value="1" min="1">
          <button type="button" class="qty-btn" onclick="var i=document.getElementById('pf-qty');i.value=+i.value+1">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <!-- Réassurance -->
      <div class="reassurance">
        <div class="reassurance__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.6" stroke="#C9A84C" stroke-width="1.4"/><circle cx="16.5" cy="17.5" r="1.6" stroke="#C9A84C" stroke-width="1.4"/></svg>
          <span>Livraison offerte dès 50€</span>
        </div>
        <div class="reassurance__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/></svg>
          <span>14 actifs naturels</span>
        </div>
        <div class="reassurance__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 5-5" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Satisfait ou remboursé</span>
        </div>
      </div>

      <!-- Accordéons -->
      <div class="accordions">
        <details class="accordion" open>
          <summary class="accordion__head">Composition — 14 ingrédients</summary>
          <div class="accordion__body">
            <div class="ingredient-chips">
              {%- assign ings = 'Usma,Ortie,Gingembre,Nigelle noire,Huile de coco,Ricin,Romarin,Ortie blanche,Argan,Aloe vera,Henné neutre,Argile,Miel brut,Charbon végétal' | split: ',' -%}
              {%- for ing in ings -%}
                <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> {{ ing }}</span>
              {%- endfor -%}
            </div>
          </div>
        </details>
        <details class="accordion">
          <summary class="accordion__head">Mode d'emploi</summary>
          <div class="accordion__body">
            <ol class="accordion__steps">
              <li><strong>Faire mousser</strong> — Frottez entre vos mains humides jusqu'à obtenir une mousse onctueuse.</li>
              <li><strong>Masser le cuir chevelu</strong> — Massez 2 minutes pour activer la microcirculation.</li>
              <li><strong>Laisser poser</strong> — 3 à 5 minutes, puis rincez à l'eau tiède.</li>
              <li><strong>Répéter 3× / semaine</strong> — Cure complète de 3 mois.</li>
            </ol>
          </div>
        </details>
        <details class="accordion">
          <summary class="accordion__head">Livraison & retours</summary>
          <div class="accordion__body">
            <p>Expédition sous 48h via Mondial Relay. Livraison offerte dès 50€ avec le code <strong style="color:#C9A84C">LIVRAISON50</strong>. Retours acceptés sous 14 jours.</p>
          </div>
        </details>
      </div>

    {%- endform -%}
  </div>

  <!-- Barre CTA fixe -->
  {%- if product.available -%}
    <div class="bottom-bar" id="bottom-bar">
      <div class="bottom-bar__info">
        <div class="bottom-bar__name">{{ product.title | truncate: 28 }}</div>
        <div class="bottom-bar__price gold-text" id="bb-price">{{ product.price | money }}</div>
      </div>
      <button class="btn btn-gold" onclick="document.getElementById('product-form').querySelector('[name=add]').click()">Ajouter au panier</button>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page Produit",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Page Produit" }]
}
{% endschema %}
