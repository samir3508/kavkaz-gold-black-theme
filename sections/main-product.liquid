{%- assign all_prods = collections['nos-produits'].products -%}

<div class="pdp">

  <!-- Galerie -->
  <div class="pdp__gallery">
    {%- if product.featured_image -%}
      <img id="pf-img" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" class="pdp__main-img" width="900" height="900" loading="eager">
    {%- else -%}
      <div class="placeholder pdp__main-img" style="height:340px"><span>Photo produit</span></div>
    {%- endif -%}
    {%- if product.images.size > 1 -%}
      <div class="pdp__thumbs">
        {%- for img in product.images -%}
          <button class="thumb {% if forloop.first %}thumb--on{% endif %}"
            data-src="{{ img | image_url: width: 900 }}"
            onclick="document.getElementById('pf-img').src=this.dataset.src;document.querySelectorAll('.thumb').forEach(t=>t.classList.remove('thumb--on'));this.classList.add('thumb--on')">
            <img src="{{ img | image_url: width: 120 }}" alt="{{ img.alt | escape }}" width="120" height="120" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Infos -->
  <div class="pdp__info">
    {%- assign is_soap = false -%}
    {%- for p in collections['nos-produits'].products -%}
      {%- if p.handle == product.handle -%}{%- assign is_soap = true -%}{%- endif -%}
    {%- endfor -%}

    {%- assign brush = all_products['brosse-massage-cuir-chevelu-kavkaz'] -%}
    {%- assign pack_product = product -%}
    {%- for p in collections['nos-produits'].products -%}
      {%- if p.handle contains 'pack' -%}{%- assign pack_product = p -%}{%- endif -%}
    {%- endfor -%}
    {%- assign is_pack_page = false -%}
    {%- if product.handle contains 'pack' -%}{%- assign is_pack_page = true -%}{%- endif -%}

    {%- capture gift_widget_row -%}
      <div class="gift-widget__row">
        <div class="gift-widget__item">
          <img src="{{ pack_product.featured_image | image_url: width: 160 }}" alt="Pack 3 savons thérapeutiques" loading="lazy" width="56" height="56">
          <span class="gift-widget__name">3 savons thérapeutiques<br><em>Cure complète 3 mois</em></span>
        </div>
        <span class="gift-widget__plus">+</span>
        <div class="gift-widget__item">
          <img src="{{ brush.featured_image | image_url: width: 160 }}" alt="Brosse de massage cuir chevelu" loading="lazy" width="56" height="56">
          <span class="gift-widget__name">Brosse de massage<br><em><s>4,90 €</s> <b>OFFERTE</b></em></span>
        </div>
      </div>
    {%- endcapture -%}

    {%- if is_soap -%}
      <div class="first-order-badge">🎁 -10% sur votre 1ère commande — code <strong>KAVKAZ10</strong></div>
      {%- if is_pack_page -%}
        <p class="pdp__eyebrow ew" id="pdp-eyebrow">Cure capillaire 3 mois</p>
        <h1 class="pdp__title" id="pdp-title">Protocole Kavkaz Gold Black — Cure Capillaire Complète 3 Mois</h1>
      {%- else -%}
        <p class="pdp__eyebrow ew" id="pdp-eyebrow">Savon noir capillaire</p>
        <h1 class="pdp__title" id="pdp-title">Kavkaz Gold Black</h1>
      {%- endif -%}
      <div class="gift-widget" id="gw-pack" {% unless is_pack_page %}style="display:none"{% endunless %}>
        <p class="gift-widget__label">🎁 Votre cure comprend</p>
        {{ gift_widget_row }}
      </div>
      <a class="gift-widget gift-widget--link" id="gw-solo" href="{{ pack_product.url }}" {% if is_pack_page %}style="display:none"{% endif %}>
        <p class="gift-widget__label">🎁 Avec la cure 3 mois : brosse offerte</p>
        {{ gift_widget_row }}
        <span class="gift-widget__cta">Découvrir la cure 3 mois →</span>
      </a>
    {%- else -%}
      <p class="pdp__eyebrow ew">Accessoire</p>
      <h1 class="pdp__title">{{ product.title }}</h1>
      {%- if product.handle contains 'brosse' -%}
        <a class="gift-widget gift-widget--link" href="{{ pack_product.url }}">
          <p class="gift-widget__label">🎁 Cette brosse est OFFERTE avec la cure 3 mois</p>
          {{ gift_widget_row }}
          <span class="gift-widget__cta">Découvrir la cure 3 mois →</span>
        </a>
      {%- endif -%}
    {%- endif -%}

    <div class="pdp__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="pdp__price-was" id="pf-compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span class="pdp__price-was" id="pf-compare" style="display:none"></span>
      {%- endif -%}
      <span class="pdp__price-now g" id="pf-price">{{ product.price | money }}</span>
    </div>

    {%- if is_soap -%}
        <p class="pdp__desc">Tu perds tes cheveux, ta barbe est trouée, tes pellicules reviennent sans cesse ? Les shampoings classiques masquent le problème. Le <strong>Protocole Kavkaz</strong> le traite — à la racine, littéralement.</p>
        <p class="pdp__desc">Formulé à partir de <strong>14 actifs bruts du Caucase</strong>, saponifiés à froid pour préserver 100 % de leur puissance :</p>
        <ul class="pdp__list">
          <li><strong>L’Usma</strong> réactive les bulbes endormis et force la repousse</li>
          <li><strong>L’Ail Noir fermenté</strong> bloque la DHT, l’hormone qui tue tes cheveux</li>
          <li><strong>La Nigelle</strong> élimine les champignons responsables des pellicules</li>
        </ul>
        <div class="pdp__desc--calendar">
          <p class="pdp__cal__title">Ton calendrier de résultats</p>
          <div class="pdp__cal__grid">
            <div class="pdp__cal__row"><span class="pdp__cal__when">Sem. 2–3</span><span class="pdp__cal__what">Pellicules éliminées</span></div>
            <div class="pdp__cal__row"><span class="pdp__cal__when">Mois 1</span><span class="pdp__cal__what">Chute ralentie</span></div>
            <div class="pdp__cal__row"><span class="pdp__cal__when">Mois 2</span><span class="pdp__cal__what">Chute stoppée, premiers duvets</span></div>
            <div class="pdp__cal__row"><span class="pdp__cal__when">Mois 3</span><span class="pdp__cal__what">Repousse visible</span></div>
          </div>
        </div>
        <div class="pdp__results">
          <span>Nettoie</span>
          <span>Désinfecte</span>
          <span>Purifie</span>
          <span>Réactive les bulbes</span>
          <span>Repousse + épaisse</span>
          <span>Repousse + forte</span>
          <span>Repousse + noire</span>
          <span>+ de densité</span>
          <span>+ de douceur</span>
          <span>Meilleure brillance</span>
        </div>
        <p class="pdp__desc">Zéro sulfate. Zéro parabène. Zéro silicone. Pour femmes et hommes — cheveux, barbe, sourcils.</p>
        <p class="pdp__desc pdp__desc--warning">⚠️ Un bulbe met 90 jours à se régénérer. C’est pourquoi cette cure dure 3 mois — pas moins.</p>
        <p class="pdp__blurb" id="pf-blurb">
          {%- if product.handle contains 'pack' -%}
            Pour tous les problèmes — pellicules, chute, alopécie, barbe trouée, repousse. 🎁 Brosse de massage offerte.
          {%- else -%}
            Pour pellicules & démangeaisons — résultats dès 2 semaines.
          {%- endif -%}
        </p>
    {%- else -%}
      {{ product.description }}
    {%- endif -%}

    {%- form 'product', product, id: 'product-form' -%}

      {%- assign product_in_collection = false -%}
      {%- for p in all_prods -%}
        {%- if p.handle == product.handle -%}{%- assign product_in_collection = true -%}{%- endif -%}
      {%- endfor -%}

      <!-- Sélecteur de format — les 2 produits (savon uniquement) -->
      {%- if product_in_collection -%}
      <span class="fl">CHOISIR LE FORMAT</span>
      <div class="variants">
        {%- for p in all_prods -%}
          {%- assign v = p.variants.first -%}
          {%- assign is_current = false -%}
          {%- if p.handle == product.handle -%}{%- assign is_current = true -%}{%- endif -%}
          {%- assign is_pack = false -%}
          {%- if p.handle contains 'pack' -%}{%- assign is_pack = true -%}{%- endif -%}
          {%- assign blurb = 'Pour pellicules & démangeaisons — résultats dès 2 semaines.' -%}
          {%- if is_pack -%}{%- assign blurb = 'Pour tous les problèmes — pellicules, chute, alopécie, barbe trouée, repousse. 🎁 Brosse de massage offerte.' -%}{%- endif -%}
          <label class="vcard {% if is_current %}vcard--on{% endif %}">
            <input type="radio" name="id" value="{{ v.id }}"
              {% if is_current %}checked{% endif %}
              data-price="{{ v.price | money }}"
              data-cents="{{ v.price }}"
              data-blurb="{{ blurb }}"
              data-img="{{ p.featured_image | image_url: width: 900 }}"
              data-is-pack="{{ is_pack }}"
              onchange="kgbSel(this)">
            <div>
              <span class="vcard__name">{% if is_pack %}Pack 3 savonnettes{% else %}Savonnette 80g{% endif %}</span>
              <span class="vcard__dur">{% if is_pack %}Chute · Repousse · Pellicules · Alopécie{% else %}Pellicules & démangeaisons uniquement{% endif %}</span>
              {% if is_pack %}<span class="vcard__gift">🎁 + Brosse de massage offerte</span>{% endif %}
            </div>
            <div class="vcard__right">
              <span class="vcard__price">{{ v.price | money }}</span>
              {%- if is_pack -%}<span class="vcard__badge">Le plus choisi</span>{%- endif -%}
              <span class="vcard__radio"></span>
            </div>
          </label>
        {%- endfor -%}
      </div>

      <!-- Guide de sélection -->
      <div class="fmt-guide">
        <p class="fl" style="margin-bottom:12px">⚠ C'EST LE MÊME SAVON — MAIS LE TEMPS CHANGE TOUT</p>
        <div class="fmt-guide__block fmt-guide__block--soft">
          <p class="fmt-guide__q">✓ Savonnette 1 mois — pour les pellicules & démangeaisons</p>
          <p class="fmt-guide__a">Le savon élimine pellicules et démangeaisons dès 2 à 3 semaines. Ce format suffit pour ces problèmes.</p>
        </div>
        <div class="fmt-guide__block fmt-guide__block--hard">
          <p class="fmt-guide__q">✗ Savonnette 1 mois — insuffisant pour la repousse</p>
          <p class="fmt-guide__a">Pour la <strong>chute de cheveux, l'alopécie, la barbe trouée ou la repousse</strong> : 1 mois ne changera <strong>absolument rien</strong>.<br><br>C'est le même savon — mais un bulbe pileux met <strong>3 mois minimum</strong> à se réactiver biologiquement. Sans cette durée, les actifs n'ont pas le temps d'agir en profondeur.<br><br>→ <strong>Cure 3 Mois obligatoire</strong> pour ces problèmes.</p>
        </div>
      </div>
      {%- else -%}
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      {%- endif -%}

      <!-- Upsell Brosse -->
      {%- assign brosse = all_products['brosse-massage-cuir-chevelu-kavkaz'] -%}
      {%- if brosse != blank and brosse.available and product_in_collection -%}
      <div class="upsell-wrap" {% if is_pack_page %}style="display:none"{% endif %}>
        <p class="fl" style="margin-bottom:10px">COMPLÉTEZ VOTRE ROUTINE</p>
        <label class="upsell-card" for="brush-cb"
          data-vid="{{ brosse.variants.first.id }}"
          data-cents="{{ brosse.variants.first.price }}">
          <input type="checkbox" id="brush-cb" style="display:none" onchange="kgbUpd()">
          {%- if brosse.featured_image -%}
            <img src="{{ brosse.featured_image | image_url: width: 160 }}" alt="Brosse" class="upsell-card__img">
          {%- endif -%}
          <div class="upsell-card__body">
            <span class="upsell-card__tag" id="brush-tag-label">RECOMMANDÉ</span>
            <span class="upsell-card__name">Brosse Massage Cuir Chevelu</span>
            <span class="upsell-card__sub">Stimule la microcirculation · amplifie les résultats du savon</span>
          </div>
          <div class="upsell-card__right">
            <span class="upsell-card__price g" id="brush-price-label">+ {{ brosse.variants.first.price | money }}</span>
            <span class="upsell-card__box" id="brush-box"></span>
          </div>
        </label>
      </div>
      {%- endif -%}

      <!-- Quantité -->
      <div class="qty-row">
        <span class="fl">QUANTITÉ</span>
        <div class="qty-ctrl">
          <button type="button" class="qbtn" onclick="var i=document.getElementById('qin');i.value=Math.max(1,+i.value-1);kgbUpd()">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
          <input type="number" id="qin" name="quantity" value="1" min="1" oninput="kgbUpd()">
          <button type="button" class="qbtn" onclick="var i=document.getElementById('qin');i.value=+i.value+1;kgbUpd()">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <!-- Réassurance -->
      <div class="reassure">
        <div class="reassure__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.6" stroke="#C9A84C" stroke-width="1.4"/><circle cx="16.5" cy="17.5" r="1.6" stroke="#C9A84C" stroke-width="1.4"/></svg>
          <span>Livraison offerte dès 69€</span>
        </div>
        <div class="reassure__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/></svg>
          <span>14 actifs naturels</span>
        </div>
        <div class="reassure__item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 5-5" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Livré en 48H en moyenne</span>
        </div>
      </div>

      <!-- Garantie -->
      <div class="guarantee-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 5-5" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div>
          <span>Satisfait ou remboursé <strong>30 jours</strong> — sans justification</span>
          <p class="guarantee-bar__note">Notre garantie porte sur la <strong>qualité du savon</strong>, pas sur une promesse de repousse. Dès les premiers lavages, vous sentirez la différence d'un soin sans sulfates ni silicones : cuir chevelu apaisé, cheveux plus sains, fini les agressions chimiques. La repousse, elle, varie selon chaque personne et demande la cure complète de 3 mois — aucun produit ne peut la garantir.</p>
        </div>
      </div>

      <!-- Bouton panier -->
      <button type="submit" name="add" id="main-atc" class="btn btn-gold btn-full btn-lg" style="margin-bottom:32px">
        Ajouter au panier
      </button>

      <!-- Accordéons -->
      <div class="accs">
        <details class="acc" open>
          <summary>Les 5 bénéfices</summary>
          <div class="acc__body">
            <ol class="acc__steps">
              <li><strong>Réactive les bulbes endormis</strong> — Repousse sur les zones nues (trous, plaques, ligne qui recule).</li>
              <li><strong>Stoppe la chute</strong> — Fortifie le cheveu et le poil dès la racine pour bloquer la perte excessive.</li>
              <li><strong>Accélère la croissance</strong> — Boost la vitesse de pousse naturelle grâce à la stimulation sanguine.</li>
              <li><strong>Densifie et épaissit</strong> — Le poil pousse plus noir, plus dur et plus épais. Effet densité immédiat.</li>
              <li><strong>Assainit le cuir chevelu</strong> — Élimine pellicules, démangeaisons et excès de sébum. Protège des agressions.</li>
            </ol>
          </div>
        </details>
        <details class="acc">
          <summary>Comment ça marche</summary>
          <div class="acc__body">
            <ol class="acc__steps">
              <li><strong>Le coup de fouet sanguin</strong> — En massant 2 minutes, le gingembre active la microcirculation. Le sang afflue massivement au bulbe.</li>
              <li><strong>L'ouverture des pores</strong> — L'argile verte nettoie les impuretés et le sébum qui étouffaient le follicule. Les pores s'ouvrent.</li>
              <li><strong>Le bombardement de nutriments</strong> — En 15 minutes de pose, l'Usma et l'ail noir pénètrent jusqu'à la racine et relancent la pousse.</li>
            </ol>
          </div>
        </details>
        <details class="acc">
          <summary>Composition — 14 ingrédients</summary>
          <div class="acc__body">
            <div class="chips">
              {%- assign ings = "Huile d'Usma,Extrait d'Ail Noir,Extrait de Gingembre,Huile de Ricin,Huile de Graine de Nigelle,Extrait d'Orchis Sauvage,Huile de Baies de Laurier,Suc d'Aloe Vera,Huile d'Olive,Huile de Coco,Extrait d'Ortie Piquante,Extrait de Romarin,Extrait de Camomille,Argile Verte & Boue Thermale" | split: ',' -%}
              {%- for ing in ings -%}
                <span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6.5" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ ing }}
                </span>
              {%- endfor -%}
            </div>
          </div>
        </details>
        <details class="acc">
          <summary>Le rituel — 5 gestes, tous les jours</summary>
          <div class="acc__body">
            <ol class="acc__steps">
              <li><strong>Mouiller</strong> — Mouillez abondamment vos cheveux.</li>
              <li><strong>Faire mousser</strong> — Frottez le savon sur le cuir chevelu pour créer une mousse onctueuse.</li>
              <li><strong>Masser le cuir chevelu</strong> — Massez doucement pendant 2 minutes.</li>
              <li><strong>Laisser poser</strong> — Laissez la mousse blanche agir <strong>10 à 15 minutes</strong> sur le cuir chevelu.</li>
              <li><strong>Rincer</strong> — Rincez abondamment à l'eau tiède.</li>
            </ol>
          </div>
        </details>
        <details class="acc">
          <summary>Livraison & retours</summary>
          <div class="acc__body">
            <p>Expédition sous 48h via Mondial Relay. Livraison offerte dès 69€ avec le code <strong style="color:#C9A84C">LIVRAISON69</strong>. Retours acceptés sous 14 jours.</p>
          </div>
        </details>
      </div>

    {%- endform -%}

    {%- if is_soap -%}
    <!-- Avis clients -->
    <div class="pdp-reviews">
      <p class="fl" style="margin-bottom:16px">CE QU'ILS EN DISENT</p>

      <!-- Widget Trustpilot -->
      <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
      <div class="trustpilot-widget"
        data-locale="fr-FR"
        data-template-id="56278e9abfbbba0bdcd568bc"
        data-businessunit-id="6a4baf085c43daa94300f228"
