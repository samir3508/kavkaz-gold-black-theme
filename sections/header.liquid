<header class="site-header" id="site-header">
  <div class="h-inner">
    <div class="h-side">
      <a href="/" id="header-back" style="display:none" aria-label="Retour" class="h-cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <a href="/" class="h-logo">
      <span class="h-logo__main">KAVKAZ</span>
      <span class="h-logo__sub">GOLD · BLACK</span>
    </a>

    <div class="h-side h-side--right">
      <a href="/cart" class="h-cart" aria-label="Panier">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
          <path d="M3 4h2l2.2 11.2a1.5 1.5 0 001.5 1.2h8.6a1.5 1.5 0 001.5-1.2L20.5 8H6.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="20" r="1.4" fill="currentColor"/>
          <circle cx="17.5" cy="20" r="1.4" fill="currentColor"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-dot">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{ "name": "En-tête" }
{% endschema %}
