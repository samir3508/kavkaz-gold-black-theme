<div id="newsletter-popup" class="nl-popup" hidden>
  <div class="nl-popup__backdrop" data-nl-close></div>
  <div class="nl-popup__panel" role="dialog" aria-modal="true" aria-labelledby="nl-popup-title">
    <button type="button" class="nl-popup__close" data-nl-close aria-label="Fermer">&times;</button>

    <div class="nl-popup__body" data-nl-step="form">
      <p class="nl-popup__eyebrow">Offre de bienvenue</p>
      <h2 id="nl-popup-title" class="nl-popup__title">-10% sur votre première commande</h2>
      <p class="nl-popup__text">Inscrivez-vous à notre newsletter et recevez votre code de réduction par email.</p>

      {% form 'customer', id: 'nl-popup-form', class: 'nl-popup__form' %}
        {% if form.posted_successfully? %}
          {% assign nl_success = true %}
        {% endif %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="1">
        <div class="nl-popup__field">
          <input type="email" name="contact[email]" placeholder="Votre email" required aria-label="Email">
          <button type="submit" class="btn btn-gold">S'inscrire</button>
        </div>
        {% if form.errors %}
          <p class="nl-popup__error">{{ form.errors.messages.first }}</p>
        {% endif %}
      {% endform %}

      <p class="nl-popup__disclaimer">En vous inscrivant, vous acceptez de recevoir nos emails. Désinscription à tout moment.</p>
    </div>

    <div class="nl-popup__body nl-popup__body--success" data-nl-step="success" hidden>
      <p class="nl-popup__eyebrow">Merci !</p>
      <h2 class="nl-popup__title">Vérifiez votre boîte mail</h2>
      <p class="nl-popup__text">Votre code de réduction -10% arrive dans quelques instants dans votre boîte mail (pensez à vérifier vos spams).</p>
    </div>
  </div>
</div>

{% if nl_success %}
  <script>window.__nlPopupPostedSuccess = true;</script>
{% endif %}
