<div class="cart-page">
  <div class="container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.2 11.2a1.5 1.5 0 001.5 1.2h8.6a1.5 1.5 0 001.5-1.2L20.5 8H6.2" stroke="rgba(249,245,240,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.4" fill="rgba(249,245,240,0.3)"/><circle cx="17.5" cy="20" r="1.4" fill="rgba(249,245,240,0.3)"/></svg>
        <p>Votre panier est vide.</p>
        <a href="/products/savon-therapeutique-kavkaz-gold-black-75g-1" class="btn btn-gold btn-lg" style="margin-top:20px">Découvrir le soin</a>
      </div>
    {%- else -%}
      {%- assign free_cents = 7000 -%}
      {%- assign pct = cart.total_price | divided_by: 7000.0 | times: 100 | at_most: 100 | round -%}

      <!-- Barre livraison -->
      <div class="ship-bar">
        <div class="ship-bar__msg">
          {%- if cart.total_price >= free_cents -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/></svg>
            <strong style="color:#C9A84C">Livraison offerte</strong>&nbsp;débloquée 🎉
          {%- else -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            Plus que <strong>{{ free_cents | minus: cart.total_price | money }}</strong> pour la livraison offerte
          {%- endif -%}
        </div>
        <div class="ship-bar__track">
          <div class="ship-bar__fill" style="width:{{ pct }}%"></div>
        </div>
      </div>

      {%- form 'cart', cart -%}
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="citem">
              <div class="citem__img">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                {%- endif -%}
              </div>
              <div class="citem__body">
                <div class="citem__name">{{ item.product.title }}</div>
                <div class="citem__var">
                  {%- if item.variant.title != 'Default Title' -%}
                    {{ item.variant.title }}
                  {%- elsif item.product.handle contains 'pack' -%}
                    Pack 3 savonnettes · Cure 3 mois
                  {%- elsif item.product.handle contains 'brosse' -%}
                    Accessoire · Massage cuir chevelu
                  {%- else -%}
                    Savonnette 80g · 1 mois de soin
                  {%- endif -%}
                </div>
                <div class="citem__price g">{{ item.line_price | money }}</div>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="citem__rm">Supprimer ×</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Code promo -->
        <div class="promo-row">
          {%- if cart.cart_level_discount_applications.size == 0 -%}
            <input type="text" id="promo-input" placeholder="Code promo" class="promo-in">
            <button type="button" class="btn btn-ghost" onclick="applyPromo()">OK</button>
          {%- else -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <span style="color:#C9A84C;font-size:13px">✓ {{ discount.title }}</span>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <script>
        function applyPromo() {
          var code = document.getElementById('promo-input').value.trim();
          if (code) window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=/cart';
        }
        document.getElementById('promo-input') && document.getElementById('promo-input').addEventListener('keydown', function(e){ if(e.key==='Enter') applyPromo(); });
        </script>

        <!-- Récap -->
        <div class="cart-recap">
          <div class="cart-recap__row">
            <span>Sous-total</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-recap__row" style="color:#C9A84C">
                <span>Réduction ({{ discount.title }})</span>
                <span>-{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
          {%- if cart.total_discount > 0 and cart.cart_level_discount_applications.size == 0 -%}
            <div class="cart-recap__row" style="color:#C9A84C">
              <span>Réduction</span>
              <span>-{{ cart.total_discount | money }}</span>
            </div>
          {%- endif -%}
          <div class="cart-recap__row cart-recap__total">
            <span>Total</span>
            <span class="g" style="font-family:var(--serif);font-size:26px">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <div class="cart-guarantee">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z" stroke="#C9A84C" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 5-5" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <span>Satisfait ou remboursé <strong>30 jours</strong> — sans justification</span>
            <p class="cart-guarantee__note">Garantie sur la qualité du savon — la repousse varie selon chaque personne et n'est pas garantie.</p>
          </div>
        </div>

        <div class="cart-actions">
          <button type="submit" name="checkout" class="btn btn-gold btn-full btn-lg">Passer la commande</button>
          <a href="/products/savon-therapeutique-kavkaz-gold-black-75g-1" class="cart-back">Continuer mes achats</a>
        </div>

        <div class="trust-row">
          <span>🔒 Paiement sécurisé</span>
          <span>📦 Mondial Relay</span>
          <span>🌿 14 actifs naturels</span>
        </div>

      {%- endform -%}
    {%- endif -%}
  </div>
</div>
